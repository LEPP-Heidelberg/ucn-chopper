<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<SYSLIB>
<MSB_FILE name="lm32_xo2.msb" path="../lm32_xo2/soc"/>
<MemorySections Deployflag="true" UCflag="true">
<Section DEPLOY="yes" Load="true" Name=".text" Value="IM_ebr"/>
<Section Load="false" Name=".rodata" Value="DMEM"/>
<Section Load="false" Name=".data" Value="DMEM"/>
</MemorySections>
<LinkerSettings>
<Param Name="UserDefinedLinkerFile" Value=""/>
</LinkerSettings>
<STDIO_Redirection>
<Param InstanceName="" Name="stdin" Text=""/>
<Param InstanceName="" Name="stdout" Text=""/>
<Param InstanceName="" Name="stderr" Text=""/>
</STDIO_Redirection>
<LibSettings>
<Param Name="SyslibOption" Value="on"/>
<Param Name="USE_SMALL_LIBC" Value="TRUE"/>
<Param Name="USE_STANDALONE_SMALL_PRINTF" Value="FALSE"/>
</LibSettings>
<PREPROCESSOR_IFDEF>
<Param IFDEF_NAME="__MICOPASSTHRU_USER_IRQ_HANDLER__" Value="off"/>
</PREPROCESSOR_IFDEF>
</SYSLIB>
